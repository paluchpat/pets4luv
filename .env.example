# TURSO_DATABASE_URL=libsql://your-preview-database.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# AI remains disabled until credits and a spending boundary are verified.
AI_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
